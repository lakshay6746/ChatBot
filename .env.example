# Required for chatbot responses
GEMINI_API_KEY=your_gemini_api_key

# Optional: enables distance-ranked fallbacks for locations missing from property.json.
# Enable the Google Maps Geocoding API for this key in Google Cloud.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Use a long random value outside local development.
FLASK_SECRET_KEY=replace_with_a_random_secret
